{
  "name": "@inradius/solid-wc",
  "version": "0.0.0",
  "description": "A Solid.js web component scaffold.",
  "type": "module",
  "scripts": {
    "build": "vite build builds/build-app/wc",
    "build:app": "vite build builds/build-app/app",
    "dev": "vite builds/build-app/app --host --open",
    "lint": "eslint src",
    "preview": "vite preview --outDir dist/qa --open",
    "test": "vitest run --coverage",
    "test:watch": "vitest --coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "@inradius/solid-wc-css-mixin": "^1.0.5",
    "@inradius/solid-wc-utils-config": "^0.1.4",
    "@solid-primitives/destructure": "^0.2.2",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "4.0.17",
    "component-register": "^0.8.8",
    "eslint": "^9.39.2",
    "filemanager-plugin": "^2.9.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "prettier": "3.8.1",
    "rollup": "^4.55.3",
    "solid-devtools": "^0.34.5",
    "solid-element": "^1.9.1",
    "solid-js": "^1.9.11",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-solid": "2.11.10",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17"
  },
  "msw": {
    "workerDirectory": [
      "src/builds/build-app/public"
    ]
