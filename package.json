{
  "name": "@inradius/solid-wc",
  "version": "0.0.0",
  "description": "A Solid.js web component scaffold.",
  "type": "module",
  "scripts": {
    "build": "pnpm build:app && pnpm build:wc",
    "build:app": "vite build src/builds/build-app/solid",
    "build:wc": "vite build src/builds/build-app/wc",
    "dev": "vite src/builds/build-app/solid --host --open",
    "prettier": "prettier src -c",
    "prettier:fix": "prettier . -w",
    "preview": "vite preview --outDir dist/solid-build",
    "preview:wc": "vite preview --outDir dist/production --open",
    "test": "vitest run --coverage",
    "test:watch": "vitest --coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "4.0.16",
    "component-register": "^0.8.8",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "prettier": "3.7.4",
    "solid-devtools": "^0.34.3",
    "solid-element": "^1.9.1",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.4",
    "vite-plugin-solid": "2.11.9",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@solid-primitives/destructure": "^0.2.2",
    "solid-js": "^1.9.5"
  }
}
